Screen { background: $background; color: $foreground; }
Page { align: center middle; }

/* Equal outer tracks keep the section centred between labels of different widths. */
.bar {
    dock: top; height: 3; padding: 0 2; border-bottom: solid $panel;
    layout: grid; grid-size: 3 1; grid-columns: 1fr auto 1fr;
}
.bar Label { height: 1fr; width: 1fr; content-align-vertical: middle; }
.brand { color: $primary; text-style: bold; }
.section { width: auto; color: $foreground 75%; text-align: center; }
.theme-name { color: $primary; text-align: right; }

.page { width: 68; max-width: 100%; height: auto; max-height: 100%; padding: 1 2; }
.page Label, .page Static, .dialog Static, .journal .title, #counts, #empty {
    width: 1fr; text-align: center;
}
.title { height: auto; color: $foreground; text-style: bold; margin: 1 0; }
.caption { color: $primary; margin: 1 0; }
.hint, .metadata, #counts { color: $foreground 72%; }
.hint { margin-top: 1; }

OptionList, SelectionList { border: none; background: $surface; padding: 0; height: auto; max-height: 12; }
OptionList:focus, SelectionList:focus { border: none; background-tint: $surface 0%; }
OptionList > .option-list--option { padding: 0 2; }
#commands, #samples { text-align: center; }
#commands { padding: 1 0; }
OptionList:focus > .option-list--option-highlighted, SelectionList:focus > .option-list--option-highlighted {
    background: $panel; color: $primary; text-style: bold;
}
#levels { width: 22; max-width: 100%; max-height: 9; margin-bottom: 1; }
Input { width: 100%; margin-bottom: 1; }
.buttons { width: 1fr; height: auto; align-horizontal: center; }
Button { min-width: 12; }
#defaults { margin-left: 1; }
#error { height: auto; color: $error; }
#settings-status { height: auto; color: $primary; }

.journal { height: 1fr; width: 100%; max-width: 126; padding: 0 2; }
.journal .title { margin-bottom: 0; }
#counts { height: auto; }
#list-label { height: 2; margin-top: 1; border-bottom: solid $panel; }
#filter-name { width: 1fr; color: $primary; text-style: bold; }
#read-status { color: $foreground 65%; max-width: 55%; text-align: right; }
#empty { color: $foreground 65%; padding: 1; }
DataTable { width: 1fr; height: 1fr; background: $background; color: $foreground; }
DataTable:focus { background-tint: $background 0%; }
DataTable > .datatable--header { background: $surface; color: $foreground 72%; text-style: none; }
DataTable:focus > .datatable--cursor { color: $foreground; background: $panel; }

Details { align: center middle; background: $background 70%; }
.dialog { height: auto; max-height: 90%; width: 76; max-width: 95%; border: round $primary; background: $surface; padding: 0 2 1 2; }
#detail-body { height: auto; max-height: 55vh; margin-bottom: 1; }
Footer { align-horizontal: center; background: $surface; color: $foreground; }
FooterKey > .footer-key--key { color: $primary; background: $panel; }
VerticalScroll { scrollbar-size: 1 1; }
